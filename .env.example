# ---------------------------------------------------------------------------
# Example configuration for agentrouter-codex-proxy.
# Copy to .env and edit as needed. (.env is gitignored; never commit real keys.)
#
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Upstream gateway base URL
AGENTROUTER_UPSTREAM=https://agentrouter.org

# Fallback API key used only when incoming requests lack an Authorization header.
# Usually Codex sends CODEX_GATEWAY_API_KEY from your user environment automatically.
# CODEX_GATEWAY_API_KEY=your-key-here

# Local loopback listen port (host defaults to 127.0.0.1; use CLI --host for Docker/LAN)
PROXY_PORT=8788

# Transport / fallback retry timings
PROXY_RETRY_DELAY_MS=300
PROXY_CONNECT_TIMEOUT_S=20.0
PROXY_READ_TIMEOUT_S=600.0

# Optional outgoing Responses request compression. Enable only after checking
# that your upstream accepts Content-Encoding: gzip. Payload sampling avoids
# compressing high-entropy data; encoded bodies are reused across retries.
PROXY_REQUEST_GZIP=0
PROXY_REQUEST_GZIP_MIN_BYTES=262144

# Compression uses a separate bounded worker pool, leaving asyncio's DNS and
# other default-executor work available. Saturation forwards the original body.
PROXY_GZIP_WORKERS=4
PROXY_GZIP_MAX_JOBS=16
# A proxy-added gzip HTTP 415 suppresses gzip for this origin/credential/project
# for 60 seconds. Set 0 to probe on every independent request.
PROXY_GZIP_REJECT_TTL_S=60
# 0 learns a conservative upload-rate hint from actual large plain requests.
# A positive value is an explicit upload rate in Mbit/s. This only guides the
# compression CPU/upload tradeoff; it never changes the decoded request body.
PROXY_GZIP_UPLOAD_MBIT_S=0
PROXY_GZIP_COST_MARGIN=2

# Pre-commit SSE priming & rate-limit recovery
PROXY_RATE_LIMIT_BASE_S=2.0
PROXY_RATE_LIMIT_MAX_DELAY_S=15.0
PROXY_MAX_RATE_LIMIT_WAIT_S=45.0
PROXY_MAX_TRANSIENT_RETRIES=6
PROXY_RECOVERY_STAGGER_S=0.6
PROXY_SSE_PRIME_FIRST_TIMEOUT_S=45.0
PROXY_SSE_PRIME_CREATED_GRACE_S=3.0

# Streaming queue budget; each queued piece is at most 65536 bytes. Small token
# chunks are forwarded immediately. Slow clients apply upstream backpressure.
PROXY_SSE_BUFFER_BYTES=1048576
# Stop inspecting initial SSE bytes/frames at these limits and forward the
# remainder verbatim. This bounds setup buffering, including unfinished frames.
PROXY_SSE_PRIME_BYTES=262144
PROXY_SSE_PRIME_FRAMES=1024

# A 429 pauses callers using the same effective credential. Use shared when
# different credentials intentionally draw on one upstream quota.
PROXY_RATE_LIMIT_SCOPE=credential
PROXY_RATE_LIMIT_PARTITIONS=256

# Image cap per request (keeps payload safely under OpenAI's 50-image limit)
PROXY_MAX_IMAGES=35

# Logging verbosity (1=info/warnings, 0=minimal)
PROXY_VERBOSE=0

# Safe fast-forward background auto-updater (used by service.py)
PROXY_AUTO_UPDATE=1
PROXY_AUTO_UPDATE_ON_START=1
PROXY_AUTO_UPDATE_INTERVAL_S=3600
